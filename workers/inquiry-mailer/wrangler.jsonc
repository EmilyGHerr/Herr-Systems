{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "herr-inquiry-mailer",
  "main": "index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "INQUIRY_FROM": "forms@herrsystems.com"
  },
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_sender_addresses": [
        "forms@herrsystems.com"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "572901",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
