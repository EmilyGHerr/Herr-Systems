{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "herr-inquiry-mailer",
  "main": "index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "INQUIRY_FROM": "forms@herrsystems.com",
    "INQUIRY_DELIVERY_MODE": "outbox"
  },
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_sender_addresses": [
        "forms@herrsystems.com"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "572901",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "INQUIRY_DB",
      "database_name": "herr-inquiries",
      "database_id": "47d4945b-0235-4e6a-ab17-558deffba796",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INQUIRY_QUEUE",
        "queue": "herr-inquiry-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "herr-inquiry-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "herr-inquiry-dead-letter"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
